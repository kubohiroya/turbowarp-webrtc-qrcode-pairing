{
  "name": "@kubohiroya/turbowarp-webrtc-qrcode-pairing",
  "version": "0.5.0",
  "description": "TurboWarp extension that pairs WebRTC peers by carrying offers and answers as QR codes.",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-webrtc-qrcode-pairing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-webrtc-qrcode-pairing.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-webrtc-qrcode-pairing/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "webrtc",
    "qrcode",
    "pairing",
    "typescript"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "docs/",
    "src/",
    "templates/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "schemas"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:flagged": "node scripts/build-flagged.ts",
    "lint": "eslint src tests scripts vite.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "node scripts/check-readme.ts",
    "template:readme": "node scripts/apply-readme-template.ts",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check && pnpm run samples:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "samples:build": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check && node --test scripts/verify-samples.mjs",
    "pages:build": "node scripts/prepare-pages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "^0.5.0",
    "@kubohiroya/turbowarp-jsqr": "^0.7.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.10.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "zxing-wasm": "3.1.4",
    "@kubohiroya/turbowarp-extension-data-editor": "^0.5.0"
  },
  "peerDependencies": {
    "@kubohiroya/turbowarp-camera-source": "^0.22.0",
    "@kubohiroya/turbowarp-jsqr": "^0.7.0",
    "@kubohiroya/turbowarp-webrtc": "^0.7.0"
  },
  "peerDependenciesMeta": {
    "@kubohiroya/turbowarp-webrtc": {
      "optional": true
    },
    "@kubohiroya/turbowarp-jsqr": {
      "optional": true
    },
    "@kubohiroya/turbowarp-camera-source": {
      "optional": true
    }
  },
  "dependencies": {
    "@kubohiroya/qrcode-structured-append": "^0.3.0"
  }
}
